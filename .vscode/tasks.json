      "type": "process",
      "label": "Lab04: Build demo",
      "command": "C:/mingw64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Wshadow",
        "-Wconversion",
        "-Wsign-conversion",
        "-fdiagnostics-color=always",
        "-g3",
        "-O0",
        "${workspaceFolder}/Lab04/Executor.cpp",
        "${workspaceFolder}/Lab04/main.cpp",
        "-o",
        "${workspaceFolder}/Lab04/main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\mingw64\\bin;${env:PATH}"
